note VSS Site Package
grab filesystem
grab string

say "Building static site..."
filesystem.create_directory("dist")
filesystem.create_directory("pages")

make index_path becomes "pages/index.html"
when filesystem.exists_file(index_path) same_as no
    filesystem.write_file(index_path, "<h1>Welcome to my VSS Site</h1><p>Generated by VSS Site Builder.</p>")
finish

make files becomes filesystem.files("pages")
make sz becomes __size(files)
make i becomes 0

during i below sz
    make file becomes files item i
    make content becomes filesystem.read_file("pages/" + file)
    
    make template becomes "<html><head><title>My VSS Site</title></head><body style='font-family: sans-serif; padding: 40px;'>"
    template becomes template + content
    template becomes template + "</body></html>"
    
    filesystem.write_file("dist/" + file, template)
    say "Built: dist/" + file
    i becomes i + 1
finish
say "Static site build complete!"
