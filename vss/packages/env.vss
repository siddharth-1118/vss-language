note VSS Env Package
grab filesystem
grab json

make args becomes __system_args()
make len becomes __size(args)

when len below 3
    say "Usage: vss env <get/set> [key] [val]"
    __system_exit(1)
finish

make cmd becomes args item 2
make env_file becomes ".vss_env"

make env_map becomes map []
when filesystem.exists_file(env_file)
    make file_content becomes filesystem.read_file(env_file)
    when __size(file_content) above 0
        env_map becomes json.parse(file_content)
    finish
finish

when cmd same_as "get"
    when len below 4
        say "Error: Key required"
        __system_exit(1)
    finish
    make key becomes args item 3
    make val becomes env_map field key
    say val
finish

when cmd same_as "set"
    when len below 5
        say "Error: Key and Value required"
        __system_exit(1)
    finish
    make key becomes args item 3
    make val becomes args item 4
    set env_map field key becomes val
    filesystem.write_file(env_file, json.stringify(env_map))
    say "Secret saved successfully!"
finish
