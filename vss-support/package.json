{
  "name": "vss-language",
  "displayName": "VSS Language",
  "description": "Syntax highlighting, diagnostics, and language support for the VSS (Very Simple Syntax) programming language",
  "version": "2.1.0",
  "publisher": "saisiddharth",
  "engines": {
    "vscode": "^1.60.0"
  },
  "icon": "logo.png",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "vss",
    "very simple syntax",
    "scripting",
    "language",
    "syntax highlighting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/siddharth-1118/vss-language"
  },
  "bugs": {
    "url": "https://github.com/siddharth-1118/vss-language/issues"
  },
  "homepage": "https://github.com/siddharth-1118/vss-language#readme",
  "activationEvents": [
    "onLanguage:vss"
  ],
  "main": "extension.js",
  "contributes": {
    "languages": [
      {
        "id": "vss",
        "aliases": [
          "VSS",
          "Very Simple Syntax",
          "vss"
        ],
        "extensions": [
          ".vss",
          ".htmvss"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vss",
        "scopeName": "source.vss",
        "path": "./syntaxes/vss.tmLanguage.json"
      }
    ]
  }
}
