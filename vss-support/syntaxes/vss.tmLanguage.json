{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "VSS",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#stdlib_modules" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#numbers" },
    { "include": "#builtins" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.vss",
          "begin": "###",
          "end": "###"
        },
        {
          "name": "comment.line.note.vss",
          "match": "\\bnote\\b.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.vss",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.vss",
              "match": "\\\\."
            },
            {
              "name": "variable.other.vss",
              "match": "\\{[^}]*\\}"
            }
          ]
        }
      ]
    },
    "stdlib_modules": {
      "patterns": [
        {
          "name": "support.class.vss",
          "match": "\\b(math|string|file|json|http|time|random|system|database|crypto|network)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.vss",
          "match": "\\b(when|orwhen|otherwise|finish|repeat|count|each|in|to|by|skip|leave|during|task|needs|send|grab|attempt|rescue|problem|choose|case|hi|bye|htmvss|object|extends|implements|choices|interface|shape|blueprint|match|async|await|yield|coroutine)\\b"
        },
        {
          "name": "keyword.other.vss",
          "match": "\\b(make|keep|becomes|say|put|into|set|field|item|read|write|add|erase|map)\\b"
        },
        {
          "name": "variable.language.vss",
          "match": "\\b(mine|parent)\\b"
        },
        {
          "name": "constant.language.boolean.vss",
          "match": "\\b(yes|no|empty)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.word.vss",
          "match": "\\b(same_as|not_same_as|above|below|at_least|at_most|not|of|exists|size|and|or)\\b"
        },
        {
          "name": "keyword.operator.arithmetic.vss",
          "match": "(\\+|\\-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.comparison.vss",
          "match": "(==|!=|<=|>=|<|>)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.vss",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.vss",
          "match": "\\b(__[a-z_]+)\\b"
        }
      ]
    }
  },
  "scopeName": "source.vss"
}
